    <string name="space_setup_title">Setup</string>
    <string name="space_setup_intro">So the space keeps running in the background, emberlight checks these points. Required points must be met.</string>
    <string name="space_setup_required">Required</string>
    <string name="space_setup_recommended">Recommended</string>
    <string name="space_setup_notifications_title">Notifications</string>
    <string name="space_setup_notifications_text">Shows the running space and notices, for example pauses or a new Wi-Fi. Without them the notice stays invisible. The server keeps running anyway.</string>
    <string name="space_setup_local_network_title">Local network</string>
    <string name="space_setup_local_network_text">Android requires this permission so guests can reach the server on the Wi-Fi. Without it the server accepts no connections.</string>
    <string name="space_setup_battery_title">Battery exemption</string>
    <string name="space_setup_battery_text">Stops Android from putting the server to sleep on battery power. emberlight needs no Play services and no account for this.</string>
    <string name="space_setup_oem_title">Background permission on your device</string>
    <string name="space_setup_oem_generic">Many manufacturers stop apps in the background even with an exemption. Look for the battery or app start menu in the settings and allow emberlight to run in the background.</string>
    <string name="space_setup_oem_honor">Battery → App launch: set emberlight to “Manage manually”, turn on all three switches (Auto-launch, Secondary launch, Run in background). Depending on the version the menu is named differently.</string>
    <string name="space_setup_oem_xiaomi">Settings → Apps → Autostart: allow emberlight. Also choose “No restrictions” under battery usage. Depending on the version the menu is named differently.</string>
    <string name="space_setup_oem_samsung">Settings → Battery → background usage limits: do not add emberlight to “Sleeping apps” or “Deep sleeping apps”.</string>
    <string name="space_setup_oem_oneplus">Settings → Battery → battery optimisation: set emberlight to “Don’t optimise”. Depending on the version the menu is named differently.</string>
    <string name="space_setup_oem_oppo">Settings → Apps → App launch management: allow emberlight, turn on auto-launch and background activity.</string>
    <string name="space_setup_oem_vivo">Settings → Battery → background power consumption: allow high consumption in the background for emberlight and allow autostart.</string>
    <string name="space_setup_oem_asus">Settings → Battery → autostart manager: allow emberlight.</string>
    <string name="space_setup_oem_nokia">Settings → Battery → exceptions: exclude emberlight from power saving.</string>
    <string name="space_setup_oem_open">Open setting</string>
    <string name="space_setup_oem_done">Done</string>
    <string name="space_setup_oem_done_hint">emberlight cannot check this point. Confirm it once you have set the option.</string>
    <string name="space_setup_oem_failed">The setting could not be opened. Please open it by hand in the system settings.</string>
    <string name="space_setup_background_title">Background use</string>
    <string name="space_setup_background_text">Android restricts the app. Allow background use in the app info.</string>
    <string name="space_setup_charger_title">Charger</string>
    <string name="space_setup_charger_text">Long spaces run best on the charger. Otherwise the battery only lasts so long.</string>
    <string name="space_setup_status_met">Met</string>
    <string name="space_setup_status_open">Open</string>
    <string name="space_setup_status_denied">Denied</string>
    <string name="space_setup_status_permanently_denied">Permanently denied. Allow it in the app settings.</string>
    <string name="space_setup_status_confirmed">Confirmed</string>
    <string name="space_setup_status_not_checkable">Cannot be checked</string>
    <string name="space_setup_status_info">Note</string>
    <string name="space_setup_action_allow">Allow</string>
    <string name="space_setup_action_app_settings">App settings</string>
    <string name="space_setup_action_battery">Allow exemption</string>
    <string name="space_setup_action_app_info">Open app info</string>
    <string name="space_setup_rationale_title">Allow local network?</string>
    <string name="space_setup_rationale_text">Guests reach the space only if emberlight may accept connections on the Wi-Fi. The permission serves only this purpose.</string>
    <string name="space_setup_rationale_confirm">Continue</string>
    <string name="space_setup_start">Start space</string>
    <string name="space_setup_start_blocked">Meet the required points first, then the space can start.</string>
    <string name="space_setup_start_anyway_title">Start anyway?</string>
    <string name="space_setup_start_anyway_text">These points are open. Without them the space can be stopped in the background, or notifications stay off.</string>
    <string name="space_setup_start_anyway_confirm">Start anyway</string>
