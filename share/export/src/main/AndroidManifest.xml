<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Nur bis Android 9 (API 28): Dort schreibt die Übernahme direkt in Pictures/. Ab Android 10 genügt der Medienspeicher
        ohne Berechtigung. Die Galerie (core:media) bekommt diese Berechtigung nicht.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
