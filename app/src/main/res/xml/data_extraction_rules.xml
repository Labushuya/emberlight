<?xml version="1.0" encoding="utf-8"?>
<!--
    emberlight hat keine Cloud und kein Konto. Es gibt bewusst kein Cloud-Backup (auch kein Google-Drive-Backup).
    Alle Domains werden daher ausgeschlossen.

    Geräte-zu-Geräte-Übertragung (<device-transfer>) schließt dieselben Domains aus. Ohne diesen Abschnitt wären App-Daten
    dort nicht eingeschränkt (ADR 0013, Speicher). Space-Daten liegen in noBackupFilesDir und sind ohnehin ausgeschlossen.
    Die Regel ist die Absicherung dafür. Sie verhindert zusätzlich, dass der Index (spaces.db) und die Dateien eines Space
    je übertragen werden.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
