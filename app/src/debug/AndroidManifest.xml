<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-Einstieg für Gerätetests (ADR 0014, docs/DEBUG-SERVER.md). Liegt nur im Debug-Build. Der Release-Build und der
    Benchmark-Build bekommen diese Datei nicht. Die Prüfung checkReleaseManifestDebugEntry bricht ab, falls das anders wäre.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".debugserver.DebugServerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.labushuya.emberlight.DEBUG_SERVER_START" />
                <action android:name="io.github.labushuya.emberlight.DEBUG_SERVER_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
