<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-Einstieg für Gerätetests (ADR 0014, docs/DEBUG-SERVER.md). Liegt im Source-Set devtools, das nur Debug- und
    Benchmark-Build einbinden (app/build.gradle.kts). Der Release-Build bekommt diese Datei nicht. Die Prüfung
    checkReleaseManifestDebugEntry bricht ab, falls das anders wäre.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!--
            Nur die Shell (adb) und System-Identitäten halten android.permission.DUMP. Normale Apps können den
            Empfänger damit nicht auslösen (docs/DEBUG-SERVER.md, Abschnitt Sicherheit).
        -->
        <receiver
            android:name=".debugserver.DebugServerReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.labushuya.emberlight.DEBUG_SERVER_START" />
                <action android:name="io.github.labushuya.emberlight.DEBUG_SERVER_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
